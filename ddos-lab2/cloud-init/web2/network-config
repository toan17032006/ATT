version: 2
ethernets:
  lan0:
    match:
      macaddress: "08:00:27:05:da:6d"
    set-name: eth0
    addresses: [10.10.20.21/24]
    routes:
      - to: default
        via: 10.10.20.1
        metric: 100
    nameservers:
      addresses: [10.10.20.1]
  mgmt0:
    match:
      macaddress: "08:00:27:49:36:dd"
    set-name: eth1
    dhcp4: true
    dhcp4-overrides:
      use-routes: false
