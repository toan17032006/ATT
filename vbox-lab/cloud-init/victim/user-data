#cloud-config
# VM: ATT-Victim (10.10.10.30) - Nginx load balancer + backend-1 + defenses
hostname: att-victim
manage_etc_hosts: true
timezone: Asia/Ho_Chi_Minh

users:
  - name: defender
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: "Defend@123"
    ssh_authorized_keys:
      - __SSH_PUBKEY__

chpasswd:
  list: |
    root:Defend@123
    defender:Defend@123
  expire: false

ssh_pwauth: true

write_files:
  # ---------------- Baseline nginx: LB + local backend-1 ----------------
  - path: /etc/nginx/sites-available/att-lab
    permissions: '0644'
    content: |
      upstream att_backend {
          server 127.0.0.1:8081 max_fails=1 fail_timeout=5s;
          server 10.10.10.40:8081 max_fails=1 fail_timeout=5s;
      }

      server {
          listen 80 default_server;
          server_name _;
          access_log /var/log/nginx/att-lab-access.log;

          location / {
              proxy_pass http://att_backend;
              proxy_next_upstream error timeout http_502 http_503 http_504;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_connect_timeout 2s;
              proxy_read_timeout 5s;
          }
      }

      server {
          listen 8081;
          default_type application/json;
          location / {
              return 200 '{"server":"backend-1","host":"att-victim"}';
          }
      }

  # ---------------- Protected nginx: rate/connection limits ----------------
  - path: /etc/nginx/sites-available/att-lab-protected
    permissions: '0644'
    content: |
      limit_req_zone $binary_remote_addr zone=req_per_ip:10m rate=10r/s;
      limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

      upstream att_backend {
          server 127.0.0.1:8081 max_fails=1 fail_timeout=5s;
          server 10.10.10.40:8081 max_fails=1 fail_timeout=5s;
      }

      server {
          listen 80 default_server;
          server_name _;
          access_log /var/log/nginx/att-lab-access.log;

          limit_req zone=req_per_ip burst=20 nodelay;
          limit_conn conn_per_ip 20;

          if ($http_user_agent ~* (LOIC|Hping|slowloris)) {
              return 403;
          }

          location / {
              proxy_pass http://att_backend;
              proxy_next_upstream error timeout http_502 http_503 http_504;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_connect_timeout 2s;
              proxy_read_timeout 5s;
          }
      }

      server {
          listen 8081;
          default_type application/json;
          location / {
              return 200 '{"server":"backend-1","host":"att-victim"}';
          }
      }

  # ---------------- Suricata DDoS rules ----------------
  - path: /etc/suricata/rules/att-ddos.rules
    permissions: '0644'
    content: |
      alert http any any -> $HOME_NET 80 (msg:"ATT LAB HTTP FLOOD"; flow:established,to_server; threshold:type both, track by_src, count 50, seconds 10; classtype:attempted-dos; sid:1000001; rev:1;)
      alert tcp any any -> $HOME_NET 80 (msg:"ATT LAB SYN FLOOD"; flags:S; threshold:type both, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:1000002; rev:1;)
      alert tcp any any -> $HOME_NET 80 (msg:"ATT LAB SLOW CONNECTION FLOOD"; flags:S; threshold:type both, track by_src, count 40, seconds 60; classtype:attempted-dos; sid:1000003; rev:1;)
      alert http any any -> $HOME_NET any (msg:"ATT LAB LOIC USER-AGENT"; http.user_agent; content:"LOIC"; nocase; classtype:attempted-dos; sid:1000004; rev:1;)
      alert udp any any -> $HOME_NET any (msg:"ATT LAB UDP FLOOD"; threshold:type both, track by_src, count 500, seconds 5; classtype:attempted-dos; sid:1000006; rev:1;)

  # ---------------- Suricata systemd override: capture lab NIC ----------------
  - path: /etc/systemd/system/suricata.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      ExecStart=
      ExecStart=/usr/bin/suricata -D -c /etc/suricata/suricata.yaml -i __LAB_IF__ --pidfile /run/suricata.pid

  # ---------------- Auto-block: Suricata alert -> UFW deny ----------------
  - path: /opt/defense/auto_block.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      LOG=/var/log/suricata/fast.log
      SEEN=/tmp/att_blocked_ips
      WHITELIST="10.10.10.1 10.10.10.30 10.10.10.40 127.0.0.1"

      : > "$SEEN"
      echo "[autoblock] watching $LOG"
      tail -F "$LOG" 2>/dev/null | while IFS= read -r line; do
          if echo "$line" | grep -qE 'ATT LAB (HTTP|SYN|SLOW|LOIC|UDP)|FLOOD|LOIC'; then
              ip=$(echo "$line" | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
              [ -z "$ip" ] && continue
              case " $WHITELIST " in
                  *" $ip "*) continue ;;
              esac
              if ! grep -qx "$ip" "$SEEN"; then
                  echo "$ip" >> "$SEEN"
                  ufw insert 1 deny from "$ip" comment 'att-autoblock' >/dev/null 2>&1 || true
                  echo "$(date -Is) BLOCK $ip" >> /var/log/att-blocks.log
                  echo "[autoblock] blocked $ip"
              fi
          fi
      done

  - path: /opt/defense/reset_blocks.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      if [ -f /tmp/att_blocked_ips ]; then
          while IFS= read -r ip; do
              [ -n "$ip" ] && ufw delete deny from "$ip" >/dev/null 2>&1
          done < /tmp/att_blocked_ips
      fi
      : > /tmp/att_blocked_ips
      # Also drop any tagged rules left from earlier runs.
      while true; do
          num=$(ufw status numbered | awk '/att-autoblock/ {gsub(/[\[\]]/,"",$1); print $1; exit}')
          [ -z "$num" ] && break
          yes | ufw delete "$num" >/dev/null 2>&1 || break
      done
      echo "UFW after reset:"
      ufw status numbered

  - path: /opt/defense/enable_defense.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -u
      IF=$(ip -o -4 addr show | awk '$4 ~ /^10\.10\.10\./ {print $2; exit}')
      if [ -z "$IF" ]; then echo "ERROR: no 10.10.10.x interface"; exit 1; fi
      echo "[1] Switch nginx to protected config"
      ln -sf /etc/nginx/sites-available/att-lab-protected /etc/nginx/sites-enabled/att-lab
      nginx -t || exit 1
      systemctl reload nginx

      echo "[2] Configure and start Suricata on $IF"
      sed -i -E 's|^([[:space:]]*HOME_NET:).*|\1 "[10.10.10.0/24]"|' /etc/suricata/suricata.yaml
      RULE_DIR=$(awk '/^default-rule-path:/ {print $2; exit}' /etc/suricata/suricata.yaml)
      [ -n "${RULE_DIR:-}" ] || RULE_DIR=/var/lib/suricata/rules
      mkdir -p "$RULE_DIR"
      touch "$RULE_DIR/suricata.rules"
      grep -q 'sid:1000001' "$RULE_DIR/suricata.rules" || \
          cat /etc/suricata/rules/att-ddos.rules >> "$RULE_DIR/suricata.rules"
      sed -i "s|^ExecStart=/usr/bin/suricata .*|ExecStart=/usr/bin/suricata -D -c /etc/suricata/suricata.yaml -i $IF --pidfile /run/suricata.pid|" \
          /etc/systemd/system/suricata.service.d/override.conf
      systemctl daemon-reload
      systemctl enable suricata >/dev/null 2>&1 || true
      systemctl restart suricata
      sleep 2
      echo -n "suricata: "; systemctl is-active suricata || true

      echo "[3] Enable UFW"
      ufw --force reset >/dev/null 2>&1
      ufw default deny incoming >/dev/null
      ufw default allow outgoing >/dev/null
      ufw allow 22/tcp >/dev/null
      ufw allow 80/tcp >/dev/null
      ufw --force enable >/dev/null
      ufw status verbose

      echo "[4] Start auto-block"
      systemctl enable --now att-autoblock
      systemctl is-active att-autoblock || true

      echo "DEFENSE ENABLED"

  - path: /opt/defense/disable_defense.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -u
      ln -sf /etc/nginx/sites-available/att-lab /etc/nginx/sites-enabled/att-lab
      nginx -t && systemctl reload nginx
      systemctl disable --now att-autoblock >/dev/null 2>&1 || true
      systemctl stop suricata >/dev/null 2>&1 || true
      /opt/defense/reset_blocks.sh >/dev/null 2>&1 || true
      ufw --force disable >/dev/null 2>&1 || true
      echo "DEFENSE DISABLED"

  - path: /opt/defense/show_stats.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "=== services ==="
      for svc in nginx suricata ufw att-autoblock; do
          printf '%-14s %s\n' "$svc" "$(systemctl is-active "$svc" 2>/dev/null || true)"
      done
      echo
      echo "=== ufw (first 30 lines) ==="
      ufw status numbered 2>/dev/null | head -30
      echo
      echo "=== suricata alerts (last 15) ==="
      tail -15 /var/log/suricata/fast.log 2>/dev/null || echo "(no fast.log yet)"
      echo
      echo "=== autoblock log ==="
      tail -15 /var/log/att-blocks.log 2>/dev/null || echo "(none)"
      echo
      echo "=== connections ==="
      ss -s
      echo
      echo "=== nginx access log (last 10) ==="
      tail -10 /var/log/nginx/att-lab-access.log 2>/dev/null || echo "(none)"

  - path: /etc/systemd/system/att-autoblock.service
    permissions: '0644'
    content: |
      [Unit]
      Description=ATT Lab auto-block (Suricata -> UFW)
      After=suricata.service ufw.service
      Wants=suricata.service

      [Service]
      ExecStart=/opt/defense/auto_block.sh
      Restart=always
      RestartSec=3
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target

runcmd:
  - |
    set -u
    for i in 1 2 3 4 5; do apt-get update -y -q && break; sleep 5; done
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q \
      nginx suricata ufw curl iproute2 net-tools tcpdump
    chmod +x /opt/defense/*.sh
    ln -sf /etc/nginx/sites-available/att-lab /etc/nginx/sites-enabled/att-lab
    rm -f /etc/nginx/sites-enabled/default
    nginx -t && systemctl restart nginx
    # Defense starts disabled; step 2 enables it.
    systemctl disable --now att-autoblock >/dev/null 2>&1 || true
    systemctl disable --now suricata >/dev/null 2>&1 || true
    ufw --force disable >/dev/null 2>&1 || true
    echo "STATUS: READY $(date -Is) role=victim defense=off" > /var/log/att-setup.log
